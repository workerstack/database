{
	"name": "database-monorepo",
	"version": "0.4.0",
	"private": true,
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@cloudflare/workers-types": "5.20261001.1",
			"@libsql/client": "0.17.4",
			"@noble/ciphers": "2.0.0",
			"@noble/hashes": "2.0.0",
			"@total-typescript/ts-reset": "0.6.1",
			"@types/node": "26.2.0",
			"@types/pg": "8.23.1",
			"@types/pluralize": "0.0.33",
			"@types/semver": "7.8.0",
			"@vitest/coverage-v8": "5.1.0",
			"ajv": "8.20.0",
			"ajv-formats": "3.0.1",
			"bun-types": "1.4.4",
			"@hono/zod-validator": "0.9.1",
			"drizzle-kit": "1.0.0-rc.4",
			"drizzle-orm": "1.0.0-rc.4",
			"hono": "4.13.13",
			"libpg-query": "17.7.4",
			"miniflare": "4.20260708.1",
			"oxc-parser": "0.152.0",
			"pg": "8.23.1",
			"pluralize": "8.0.0",
			"postgres": "3.4.9",
			"re2js": "2.8.8",
			"semver": "7.8.5",
			"ts-morph": "28.0.0",
			"typescript": "7.0.2",
			"vitest": "5.1.0",
			"wrangler": "4.147.0",
			"zod": "4.6.0"
		}
	},
	"type": "module",
	"scripts": {
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"postinstall": "repo sync --postinstall",
		"prepare": "lefthook install --reset-hooks-path",
		"test": "bun run --filter @workerstack/database test",
		"test:all": "bun run --filter @workerstack/database test:all",
		"test:bun": "bun run --filter @workerstack/database test:bun",
		"test:consumers": "bun run --filter @workerstack/database test:consumers",
		"test:coverage": "bun run --filter @workerstack/database test:coverage",
		"test:differential": "bun run --filter @workerstack/database test:differential",
		"test:e2e": "bun --filter @workerstack/database test:e2e",
		"test:watch": "bun run --filter @workerstack/database test:watch",
		"typecheck": "bun run --filter @workerstack/database type:check",
		"typecheck:strict": "bun run --filter @workerstack/database type:check:strict"
	},
	"devDependencies": {
		"@clack/prompts": "^0.11.0",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@workerstack/repo": "0.2.0-rc.2",
		"lefthook": "2.2.2",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"smol-toml": "^1.8.0"
	},
	"packageManager": "bun@1.4.4"
}
